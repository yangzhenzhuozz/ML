{
    "name": "ML",
    "sshConfigPath": "~/.ssh/config",
    "host": "codewave",
    "remotePath": "/home/ubuntu/ML",
    "uploadOnSave": true,
    "watcher": {
        "files": "**/*",
        "autoUpload": true,
        "autoDelete": true
    },
    "ignore": [
        "**/.git",
        "**/.git/**",
        "**/node_modules",
        "**/node_modules/**",
        "**/dist",
        "**/dist/**",
        "docs/.vitepress/cache",
        "docs/.vitepress/cache/**",
        "docs/.vitepress/.temp",
        "docs/.vitepress/.temp/**"
    ]
}